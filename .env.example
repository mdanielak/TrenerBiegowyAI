# Przykładowe nazwy zmiennych środowiskowych. Nie zapisuj prawdziwych sekretów w repozytorium.
# Skopiowany plik .env jest ignorowany przez Git. Zmienne środowiskowe systemu mają pierwszeństwo.
# Linux/macOS: HEALTH_DATA_DIR=$HOME/HealthData
# Windows: HEALTH_DATA_DIR=C:\Users\twoj_uzytkownik\HealthData

HEALTH_DATA_DIR=
SNAPSHOT_TTL_SECONDS=86400
GARMIN_EMAIL=
# GARMIN_PASSWORD można zostawić puste, jeśli masz już zapisany token OAuth
# (~/.GarminDb/garmin_tokens.json). Ustaw hasło, aby token odtwarzał się
# automatycznie po wygaśnięciu — inaczej logowanie zgłosi błąd.
GARMIN_PASSWORD=
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4o
AI_DATA_EXPORT_ENABLED=false
