# REFERENCE ONLY — do not create .env file!
#
# Use system environment variables instead:
#
# PowerShell (permanent, per-user):
#   [System.Environment]::SetEnvironmentVariable("GARMIN_EMAIL", "your@email.com", "User")
#   [System.Environment]::SetEnvironmentVariable("GARMIN_PASSWORD", "your_password", "User")
#
# Or temporary (current terminal session only):
#   $env:GARMIN_EMAIL = "your@email.com"
#   $env:GARMIN_PASSWORD = "your_password"

GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_password
