  "narrative": {
    "northStar": "Przejrzyste centrum treningu",
    "overview": "Interfejs jest spokojny, rzeczowy i czytelny. Dane i działania są pogrupowane w proste, powściągliwe karty; pierwszeństwo mają informacja i zadanie użytkownika. Kolorowe ilustracje i sportowy kobalt nadają produktowi charakter, nie konkurując z treścią.\n\nGłówny obszar zachowuje gęstość odpowiednią dla pulpitu z danymi. Obramowania, różnice powierzchni i subtelne cienie oddzielają elementy. Jasny i ciemny motyw są równorzędnymi wariantami tej samej struktury.",
    "keyCharacteristics": [
      "Spokojny pulpit z czytelną hierarchią danych.",
      "Sportowy kobalt dla nawigacji i działań.",
      "Stany opisane tekstem, wspierane kolorem i ikoną.",
      "Subtelnie oddzielone karty oraz lokalne ilustracje."
    ],
    "rules": [
      {
        "name": "The Text With Color Rule",
        "body": "Zieleń, bursztyn i czerwień sygnalizują stan wraz z tekstem; nie niosą informacji samodzielnie. Warianty `ok`, `warn` i `danger` mają osobne kolory tekstu, tła i ikon.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do stosuj istniejące zmienne semantyczne i sprawdzaj oba motywy osobno.",
      "Do łącz stan kolorystyczny z widoczną etykietą lub opisem.",
      "Do zachowuj widoczny fokus oraz szanuj ustawienie ograniczonego ruchu.",
      "Do korzystaj z lokalnych zasobów i istniejących komponentów."
    ],
    "donts": [
      "Don't komunikuj znaczenia wyłącznie kolorem.",
      "Don't zakładaj, że wartości i kontrast motywu jasnego działają również w ciemnym.",
      "Don't dodawaj zewnętrznych zasobów wizualnych wymagających połączenia z siecią."
